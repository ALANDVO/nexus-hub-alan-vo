# Application
APP_NAME=nexus-hub
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+psycopg2://nexus:nexus@localhost:5432/nexus
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=nexus
KEYCLOAK_CLIENT_ID=nexus-backend
KEYCLOAK_CLIENT_SECRET=
OIDC_ISSUER=http://localhost:8080/realms/nexus
OIDC_AUDIENCE=nexus-api
OIDC_JWKS_CACHE_TTL=300

# LLM
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT=30.0

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
HNSW_INDEX_PATH=/data/hnsw_index

# Security
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5173

# Demo mode (binds to localhost only, refuses in production)
DEMO_MODE=false
DEMO_BIND_HOST=127.0.0.1